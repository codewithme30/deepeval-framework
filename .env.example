# Copy to .env and fill in. NEVER commit the real .env file.

# Required for LLM-as-a-judge metrics (the judge is always a real OpenAI model,
# even when APP_MODE=stub).
OPENAI_API_KEY=sk-your-key-here

# Optional: override config/settings.yaml without editing it.
# APP_MODE=stub          # stub (default, deterministic) | live (calls OpenAI)
# JUDGE_MODEL=gpt-4o-mini

# Optional: push results to the Confident AI dashboard. Tests that need it are skipped without it.
# CONFIDENT_API_KEY=
